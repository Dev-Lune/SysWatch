    <string name="pair_error_bad_code_title">Dieser Code sieht falsch aus</string>
    <string name="pair_error_bad_code_fix">Er besteht aus 6 Buchstaben und Ziffern und wird in SysWatch auf deinem PC angezeigt. Er enthält nie 0, 1, I oder O.</string>
    <string name="pair_error_bad_address_title">Diese Adresse sieht falsch aus</string>
    <string name="pair_error_bad_address_fix">Gib sie so ein, wie dein PC sie anzeigt, zum Beispiel 192.168.1.5. Ohne http und ohne Port.</string>
    <string name="pair_error_bad_port_title">Dieser Port sieht falsch aus</string>
    <string name="pair_error_bad_port_fix">Nimm den Port, den dein PC anzeigt. Er lautet 47800, sofern du ihn nicht geändert hast.</string>
