# Same policy as vercel.json. The site ships no JavaScript and loads nothing off-origin.
/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; manifest-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# The sitemap is data, not a page. Browsers draw XML with their own built-in styles and
# script, which the policy above blocks: the tree then shows as raw text with stray "..." lines.
/sitemap.xml
  ! Content-Security-Policy

/assets/*
  Cache-Control: public, max-age=31536000, immutable
