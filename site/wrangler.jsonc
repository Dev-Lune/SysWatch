// Cloudflare Workers, static assets only (no Worker script).
// Deploy from this folder: npx wrangler deploy
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "syswatch-site",
  "compatibility_date": "2026-11-11",
  // The zone devlune.in is on this Cloudflare account; this creates the DNS
  // record and certificate for the subdomain.
  "routes": [{ "pattern": "syswatch.devlune.in", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./",
    // /de is served from de.html; /de.html and /de/ redirect to /de.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
